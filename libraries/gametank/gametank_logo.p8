gametank {
%option merge    
    ubyte[] LogoXVals = [
        $00,22,33,43,55,65,75,85,92,96,103,
        $00,22,33,43,55,65,75,85,92,96,102,
        $00,22,33,43,55,65,75,85,92,96,102,
        $00,22,33,43,55,65,75,85,92,96,101,
        $00,22,33,39,43,55,65,75,81,85,92,96,100,
        $00,22,33,39,43,55,65,75,81,85,92,96,
        $00,22,27,33,43,47,51,55,67,75,85,96,
        $00,22,28,33,43,47,51,55,67,75,85,96,
        $00,22,28,33,39,43,48,51,55,67,75,81,85,89,96,
        $00,22,28,33,39,43,51,55,67,75,81,85,89,96,
        $00,22,28,33,39,43,51,55,67,75,81,85,90,96,
        $00,22,28,33,39,43,51,55,67,75,81,85,90,96,100,
        $00,22,33,39,43,51,55,67,75,81,85,91,96,101,
        $00,22,33,39,43,51,55,67,75,81,85,91,96,102,
        $00,22,33,39,43,51,55,67,75,81,85,92,96,103,
        $00,$00,]

    ubyte[] LogoWVals = [
        $00,10,9,11,9,9,9,3,3,3,2,
        $00,10,9,11,9,9,9,4,3,3,3,
        $00,10,9,11,9,9,9,4,3,3,3,
        $00,10,9,11,9,9,9,5,3,3,4,
        $00,10,3,3,11,4,9,3,3,6,3,3,4,
        $00,4,3,3,11,4,9,3,3,6,3,7,
        $00,4,5,9,3,3,3,4,4,9,10,7,
        $00,4,4,9,3,3,3,9,4,9,10,6,
        $00,4,4,3,3,3,1,3,9,4,3,3,3,6,6,
        $00,4,4,3,3,3,3,4,4,3,3,3,6,7,
        $00,4,4,3,3,3,3,4,4,3,3,3,5,7,
        $00,4,4,3,3,3,3,4,4,3,3,3,5,3,4,
        $00,10,3,3,3,3,9,4,3,3,3,4,3,4,
        $00,10,3,3,3,3,9,4,3,3,3,4,3,3,
        $00,10,3,3,3,3,9,4,3,3,3,3,3,2,
        $00,$00,]

        sub draw_gametank_logo(ubyte color) {
            ubyte i
            ubyte y
            ubyte width

            ; enable blitter
            flagsMirror |= DMA_ENABLE|DMA_GCARRY|DMA_IRQ|DMA_COLORFILL_ENABLE
            dma_flags = flagsMirror

            ; static values  
            BLIT_HEIGHT = 1
            BLIT_COLOR = color

            ; logo starts on row 56 (actually maybe 57?)
            y = 56
            ; figure out size of array.
            for i in 0 to sizeof(LogoWVals)-1 {
                width = LogoWVals[i]
                if width == 0 {
                    y++
                    gametank.BLIT_VY = y
                    continue
                }
                BLIT_VX = LogoXVals[i]
                BLIT_WIDTH = width
                BLIT_START = 1
                ;gametank.blitwait()
            }

            ; disable blitter
            flagsMirror &= ~(DMA_ENABLE|DMA_COLORFILL_ENABLE)
            dma_flags = flagsMirror
        }
}
